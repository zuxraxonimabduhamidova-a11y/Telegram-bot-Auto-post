# Bu fayl faqat NAMUNA. Haqiqiy qiymatlarni Render → Environment bo'limiga kiriting.
# .env faylini hech qachon GitHub'ga yuklamang (.gitignore'da bor).

# --- MAJBURIY ---
BOT_TOKEN=            # @BotFather dan olingan token
GEMINI_API_KEY=       # https://aistudio.google.com/apikey
ADMIN_IDS=            # Telegram ID(lar), vergul bilan: 123456789,987654321

# --- IXTIYORIY (standart qiymatlar ko'rsatilgan) ---
CHANNEL_ID=@marketingsotuv
CHANNEL_SIGNATURE=@marketingsotuv
POST_TIMES=09:00,19:00
TIMEZONE=Asia/Tashkent
APPROVAL_MINUTES=15
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
POST_MAX_CHARS=950
MAX_REGENERATIONS=5
KEEP_ALIVE=1
# TOPICS=Mavzu 1;Mavzu 2;Mavzu 3   # berilsa topics.txt o'rniga ishlatiladi
